Subject: [PATCH] Configurable map decorations limit


diff --git a/src/main/java/com/adallei/alr/AlrConfig.java b/src/main/java/com/adallei/alr/AlrConfig.java
index fc9248cda9cef9b0e5072153a026c61efd079382..a4db88d291f67f738ba18c87e51a7d8604d47472 100644
--- a/src/main/java/com/adallei/alr/AlrConfig.java
+++ b/src/main/java/com/adallei/alr/AlrConfig.java
@@ -186,4 +186,9 @@ public class AlrConfig {
     private static void noPermissionMessage() {
                 noPermissionMessage = ChatColor.translateAlternateColorCodes('&', getString("messages.no-permission", noPermissionMessage));
             }
+
+    public static int mapDecorationsLimit = 20;
+    private static void mapDecorationsLimit(){
+        mapDecorationsLimit = getInt("settings.map-decorations-limit",20);
+    }
 }
diff --git a/src/main/java/net/minecraft/server/WorldMap.java b/src/main/java/net/minecraft/server/WorldMap.java
index 59173605ee8406b021576329657a8f1477fe10ad..bf739219fbafef5db296d0e4b09236b65271f602 100644
--- a/src/main/java/net/minecraft/server/WorldMap.java
+++ b/src/main/java/net/minecraft/server/WorldMap.java
@@ -282,9 +282,31 @@ public class WorldMap extends PersistentBase {
             }
         }
 
+        if (countMapIcon() >= com.adallei.alr.AlrConfig.mapDecorationsLimit) return; // Alr - Map decorations limit
         this.decorations.put(s, new MapIcon(mapicon_type, b0, b1, b2));
     }
 
+    // Alr start - Map decorations limit
+    private int countMapIcon() {
+        int count = 0;
+
+        for (MapIcon icon : decorations.values()) {
+            switch (icon.b()) {
+                case PLAYER:
+                case PLAYER_OFF_MAP:
+                case PLAYER_OFF_LIMITS:
+                case MANSION:
+                case MONUMENT:
+                    continue;
+                default:
+                    count += 1;
+            }
+        }
+
+        return count;
+    }
+    // Alr end
+
     @Nullable
     public Packet<?> a(ItemStack itemstack, World world, EntityHuman entityhuman) {
         WorldMap.WorldMapHumanTracker worldmap_worldmaphumantracker = (WorldMap.WorldMapHumanTracker) this.k.get(entityhuman);
