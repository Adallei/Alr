From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Softik Lord <dimap9986@gmail.com>
Date: Thu, 14 Jul 2022 04:57:46 +0500
Subject: [PATCH] Async spawn chunks


diff --git a/src/main/java/com/adallei/alr/Constants.java b/src/main/java/com/adallei/alr/Constants.java
new file mode 100644
index 0000000000000000000000000000000000000000..143b4814c6f5f4fdb08f506c0d8af6088ba5c6aa
--- /dev/null
+++ b/src/main/java/com/adallei/alr/Constants.java
@@ -0,0 +1,5 @@
+package com.adallei.alr;
+
+public class Constants {
+    public static final Runnable NULL_RUNNABLE = () -> {};
+}
diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 00152e1780e772c5c9b43754afa8c1fe119999c7..963b0f215c3a0242729fc2486e76f59904804649 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -391,7 +391,7 @@ public abstract class MinecraftServer implements ICommandListener, Runnable, IAs
                     }
 
                     ++i;
-                    worldserver.getChunkProviderServer().getChunkAt(blockposition.getX() + k >> 4, blockposition.getZ() + l >> 4);
+                    worldserver.getChunkProviderServer().getChunkAt(blockposition.getX() + k >> 4, blockposition.getZ() + l >> 4, com.adallei.alr.Constants.NULL_RUNNABLE); // Alr - Async Spawn Chunks
                 }
             }
         }
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index b7195085875d7e20eb6127ef558ccd93d8ef9c91..14ef76534250021bdc9a0dc238f1e28401d7fa96 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1001,7 +1001,7 @@ public final class CraftServer implements Server {
                     }
 
                     BlockPosition chunkcoordinates = internal.getSpawn();
-                    internal.getChunkProviderServer().getChunkAt(chunkcoordinates.getX() + j >> 4, chunkcoordinates.getZ() + k >> 4);
+                    internal.getChunkProviderServer().getChunkAt(chunkcoordinates.getX() + j >> 4, chunkcoordinates.getZ() + k >> 4, com.adallei.alr.Constants.NULL_RUNNABLE); // Alr - Async Spawn Chunks
                 }
             }
         }
